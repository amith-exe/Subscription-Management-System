{
  "name": "subscription-management-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "services/*"],
  "scripts": {
    "dev": "docker compose up -d postgres redis && npm run dev --workspace @subscription/api",
    "dev:web": "npm run dev --workspace @subscription/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run prisma:generate --workspace @subscription/api",
    "db:migrate": "npm run prisma:migrate --workspace @subscription/api",
    "db:seed": "npm run prisma:seed --workspace @subscription/api",
    "db:studio": "npm run prisma:studio --workspace @subscription/api"
  },
  "engines": { "node": ">=20" }
}
