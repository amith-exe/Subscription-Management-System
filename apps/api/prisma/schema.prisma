generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN INTERNAL CUSTOMER }
enum BillingPeriod { DAILY WEEKLY MONTHLY YEARLY }
enum SubscriptionStatus { DRAFT QUOTATION CONFIRMED ACTIVE CLOSED }
enum InvoiceStatus { DRAFT CONFIRMED PAID CANCELLED OVERDUE }
enum TaxType { PERCENTAGE FIXED }
enum DiscountType { FIXED PERCENT }
enum DiscountScope { PRODUCT SUBSCRIPTION }
enum PaymentMethod { CASH CARD BANK_TRANSFER OTHER }

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  resetToken   String?
  resetExpiry  DateTime?
  customer     Customer?
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Customer {
  id            String         @id @default(uuid())
  userId        String         @unique
  name          String
  company       String?
  address       String?
  taxId         String?
  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Product {
  id          String           @id @default(uuid())
  name        String
  type        String
  salesPrice  Decimal          @db.Decimal(19, 4)
  costPrice   Decimal          @db.Decimal(19, 4)
  notes       String?
  variants    ProductVariant[]
  lines       SubscriptionLine[]
  invoiceLines InvoiceLine[]
  discountProducts DiscountProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  attribute   String
  value       String
  extraPrice  Decimal  @db.Decimal(19, 4)
  product     Product  @relation(fields: [productId], references: [id])
  lines       SubscriptionLine[]
  quotationLines QuotationTemplateLine[]
  @@unique([productId, attribute, value])
}

model Plan {
  id             String         @id @default(uuid())
  name           String
  price          Decimal        @db.Decimal(19, 4)
  billingPeriod  BillingPeriod
  minQuantity    Int            @default(1)
  startDate      DateTime
  endDate        DateTime?
  autoClose      Boolean        @default(true)
  allowEarlyClose Boolean       @default(false)
  allowPause     Boolean        @default(false)
  allowRenew     Boolean        @default(true)
  subscriptions  Subscription[]
  templates      QuotationTemplate[]
}

model QuotationTemplate {
  id           String                    @id @default(uuid())
  name         String
  planId       String
  validityDays Int
  plan         Plan                      @relation(fields: [planId], references: [id])
  lines        QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         String           @id @default(uuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int
  template   QuotationTemplate @relation(fields: [templateId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
}

model Subscription {
  id             String             @id @default(uuid())
  number         Int                @unique @default(autoincrement())
  customerId     String
  planId         String
  startDate      DateTime
  expiryDate     DateTime?
  paymentTerms   String
  status         SubscriptionStatus @default(DRAFT)
  nextBillingDate DateTime?
  customer       Customer           @relation(fields: [customerId], references: [id])
  plan           Plan               @relation(fields: [planId], references: [id])
  lines          SubscriptionLine[]
  invoices       Invoice[]
  discountLinks  DiscountSubscription[]
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String         @id @default(uuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int
  unitPrice      Decimal        @db.Decimal(19, 4)
  taxId          String?
  amount         Decimal        @db.Decimal(19, 4)
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  tax            Tax?           @relation(fields: [taxId], references: [id])
}

model Tax {
  id       String           @id @default(uuid())
  name     String
  rate     Decimal          @db.Decimal(9, 4)
  type     TaxType
  lines    SubscriptionLine[]
}

model Discount {
  id              String         @id @default(uuid())
  type            DiscountType
  value           Decimal        @db.Decimal(19, 4)
  minPurchase     Decimal?       @db.Decimal(19, 4)
  minQuantity     Int?
  startDate       DateTime
  endDate         DateTime?
  usageLimit      Int?
  usedCount       Int            @default(0)
  appliesTo       DiscountScope
  products        DiscountProduct[]
  subscriptions   DiscountSubscription[]
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  @@id([discountId, productId])
}

model DiscountSubscription {
  discountId     String
  subscriptionId String
  discount       Discount     @relation(fields: [discountId], references: [id])
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  @@id([discountId, subscriptionId])
}

model Invoice {
  id            String        @id @default(uuid())
  number        Int           @unique @default(autoincrement())
  subscriptionId String
  customerId    String
  status        InvoiceStatus @default(DRAFT)
  periodStart   DateTime
  periodEnd     DateTime
  subtotal      Decimal       @db.Decimal(19, 4)
  taxTotal      Decimal       @db.Decimal(19, 4)
  discountTotal Decimal       @db.Decimal(19, 4)
  total         Decimal       @db.Decimal(19, 4)
  dueDate       DateTime
  subscription  Subscription  @relation(fields: [subscriptionId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  lines         InvoiceLine[]
  payments      Payment[]
  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([status, dueDate])
  @@index([customerId])
}

model InvoiceLine {
  id             String   @id @default(uuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(19, 4)
  taxAmount      Decimal  @db.Decimal(19, 4)
  discountAmount Decimal  @db.Decimal(19, 4)
  amount         Decimal  @db.Decimal(19, 4)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  product        Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(19, 4)
  paidAt    DateTime      @default(now())
  note      String?
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  @@index([invoiceId, paidAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model MonthlySnapshot {
  id            String   @id @default(uuid())
  month         DateTime @unique
  mrr           Decimal  @db.Decimal(19, 4)
  activeCount   Int
  newCount      Int
  churnedCount  Int
  revenue       Decimal  @db.Decimal(19, 4)
  outstanding   Decimal  @db.Decimal(19, 4)
}
