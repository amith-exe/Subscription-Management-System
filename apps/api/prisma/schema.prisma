datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  ADMIN
  INTERNAL
  CUSTOMER
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_2FA
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
  OVERDUE
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentAttemptStatus {
  CREATED
  PAID
  FAILED
}

// =========================================================
// CORE MODELS
// =========================================================

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String
  role               Role            @default(CUSTOMER)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean         @default(false)
  isActive           Boolean         @default(true)
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  customer           Customer?
  otps               Otp[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs          AuditLog[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([role])
}

model Otp {
  id         String     @id @default(uuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  maxAttempts Int       @default(5)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model RefreshToken {
  id          String        @id @default(uuid())
  userId      String
  tokenHash   String        @unique
  familyId    String
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedById String?       @unique
  userAgent   String?
  ip          String?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy  RefreshToken? @relation("RefreshReplacement", fields: [replacedById], references: [id])
  replaces    RefreshToken? @relation("RefreshReplacement")

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id            String         @id @default(uuid())
  userId        String         @unique
  name          String
  company       String?
  address       String?
  taxId         String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([name])
}

model Product {
  id                String                  @id @default(uuid())
  name              String
  type              String
  salesPrice        Decimal                 @db.Decimal(12, 2)
  costPrice         Decimal                 @db.Decimal(12, 2)
  notes             String?
  isActive          Boolean             @default(true)
  variants          ProductVariant[]
  quotationLines    QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  discountProducts  DiscountProduct[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([name])
}

model ProductVariant {
  id                String                  @id @default(uuid())
  productId         String
  attribute         String
  value             String
  extraPrice        Decimal                 @db.Decimal(12, 2)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines    QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([productId, attribute, value])
  @@index([productId])
}

model Plan {
  id              String              @id @default(uuid())
  name            String
  price           Decimal             @db.Decimal(12, 2)
  billingPeriod   BillingPeriod
  minQuantity     Int                 @default(1)
  startDate       DateTime
  endDate         DateTime?
  autoClose       Boolean             @default(true)
  allowEarlyClose Boolean             @default(false)
  allowPause      Boolean             @default(false)
  allowRenew      Boolean             @default(true)
  subscriptions   Subscription[]
  templates       QuotationTemplate[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model QuotationTemplate {
  id           String                  @id @default(uuid())
  name         String
  planId       String
  validityDays Int
  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines        QuotationTemplateLine[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([planId])
}

model QuotationTemplateLine {
  id         String            @id @default(uuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int               @default(1)
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([templateId])
}

model Tax {
  id                String             @id @default(uuid())
  name              String
  rate              Decimal            @db.Decimal(7, 4)
  type              TaxType            @default(PERCENTAGE)
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Subscription {
  id              String                 @id @default(uuid())
  number          String                 @unique
  customerId      String
  planId          String
  startDate       DateTime
  expiryDate      DateTime?
  paymentTerms    String
  status          SubscriptionStatus     @default(DRAFT)
  nextBillingDate DateTime?
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan            Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines           SubscriptionLine[]
  invoices        Invoice[]
  discountLinks   DiscountSubscription[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([status, nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxId          String?
  taxRate        Decimal         @default(0) @db.Decimal(7, 4)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  subtotal       Decimal         @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
}

model Invoice {
  id             String          @id @default(uuid())
  number         String          @unique
  subscriptionId String
  customerId     String
  status         InvoiceStatus   @default(DRAFT)
  issueDate      DateTime        @default(now())
  dueDate        DateTime
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal         @db.Decimal(12, 2)
  taxTotal       Decimal         @db.Decimal(12, 2)
  discountTotal  Decimal         @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  amountPaid     Decimal         @default(0) @db.Decimal(12, 2)
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines          InvoiceLine[]
  payments       Payment[]
  paymentAttempts PaymentAttempt[]
  discountUsages DiscountUsage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([issueDate])
}

model InvoiceLine {
  id             String   @id @default(uuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(7, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model Discount {
  id            String                 @id @default(uuid())
  code          String?                @unique
  name          String
  type          DiscountType
  value         Decimal                @db.Decimal(12, 2)
  minPurchase   Decimal?               @db.Decimal(12, 2)
  minQuantity   Int?
  startDate     DateTime
  endDate       DateTime?
  usageLimit    Int?
  usedCount     Int                    @default(0)
  isActive      Boolean                @default(true)
  appliesTo     DiscountScope
  products      DiscountProduct[]
  subscriptions DiscountSubscription[]
  usages        DiscountUsage[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([isActive, startDate, endDate])
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([discountId, productId])
}

model DiscountSubscription {
  discountId     String
  subscriptionId String
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([discountId, subscriptionId])
}

model DiscountUsage {
  id            String   @id @default(uuid())
  discountId    String
  invoiceId     String
  amountApplied Decimal  @db.Decimal(12, 2)
  appliedAt     DateTime @default(now())
  discount      Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([discountId, invoiceId])
  @@index([discountId])
  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime      @default(now())
  note      String?
  reference String?
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model PaymentAttempt {
  id              String              @id @default(uuid())
  invoiceId       String
  providerOrderId String              @unique
  paymentId       String?             @unique
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("INR")
  status          PaymentAttemptStatus @default(CREATED)
  method          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  invoice         Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
}

// =========================================================
// ANALYTICS & AUDIT SUPPORT
// =========================================================

model MonthlySnapshot {
  id                    String   @id @default(uuid())
  month                 DateTime @unique
  activeSubscriptions   Int      @default(0)
  newSubscriptions      Int      @default(0)
  churnedSubscriptions  Int      @default(0)
  mrr                   Decimal  @db.Decimal(12, 2) @default(0)
  arr                   Decimal  @db.Decimal(12, 2) @default(0)
  mrrNew                Decimal  @db.Decimal(12, 2) @default(0)
  mrrExpansion          Decimal  @db.Decimal(12, 2) @default(0)
  mrrContraction        Decimal  @db.Decimal(12, 2) @default(0)
  mrrChurned            Decimal  @db.Decimal(12, 2) @default(0)
  mrrNetMovement        Decimal  @db.Decimal(12, 2) @default(0)
  revenueCollected      Decimal  @db.Decimal(12, 2) @default(0)
  outstandingAmount     Decimal  @db.Decimal(12, 2) @default(0)
  overdueAmount         Decimal  @db.Decimal(12, 2) @default(0)
  overdueInvoiceCount   Int      @default(0)
  agingCurrent          Decimal  @db.Decimal(12, 2) @default(0)
  aging30To60           Decimal  @db.Decimal(12, 2) @default(0)
  aging60To90           Decimal  @db.Decimal(12, 2) @default(0)
  aging90Plus           Decimal  @db.Decimal(12, 2) @default(0)
  cohortData            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([month])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Sequence {
  name         String   @id
  currentValue Int      @default(0)
  prefix       String
  padding      Int      @default(6)
  updatedAt    DateTime @updatedAt
}
