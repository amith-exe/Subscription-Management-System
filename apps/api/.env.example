# PostgreSQL connection string (required)
DATABASE_URL=postgresql://subscriptions:subscriptions@localhost:5432/subscriptions?schema=public
# Runtime environment
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Separate HS256 secrets, each at least 32 characters
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
# Gmail SMTP over STARTTLS on port 587
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-mailbox@example.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=Brightloop <your-mailbox@example.com>
# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Feature flags
SWAGGER_ENABLED=true
LOGIN_2FA_ENABLED=false
QUEUE_ENABLED=false
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
RESET_METHOD=LINK
LOG_OTP_IN_DEV=false
# Razorpay Test Mode credentials (required to accept payments)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
